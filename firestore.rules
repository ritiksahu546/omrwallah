rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core identity and validation helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection (PII Isolation: read restricted strictly to the owner; enumeration blocked)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
                    && incoming().userId == request.auth.uid;
      allow update: if isOwner(userId)
                    && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Saved OMR Sheets collection
    match /omr_sheets/{sheetId} {
      allow get: if resource.data.isPublic == true || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(sheetId)
                    && incoming().userId == request.auth.uid
                    && incoming().title is string
                    && incoming().title.size() <= 200;
      allow update: if isAuthenticated()
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId;
      allow delete: if isAuthenticated() && existing().userId == request.auth.uid;
    }

    // Test Results collection
    match /test_results/{resultId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidId(resultId)
                    && incoming().userId == request.auth.uid
                    && incoming().testName is string
                    && incoming().testName.size() <= 200;
      allow update: if isAuthenticated()
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId;
      allow delete: if isAuthenticated() && existing().userId == request.auth.uid;
    }
  }
}

